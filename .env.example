# Branded email delivery. Keep API keys server-side only.
RESEND_API_KEY=
EMAIL_FROM_NAME=IELTS Writing
EMAIL_FROM_ADDRESS=noreply@ieltswriting.online
EMAIL_VERIFICATION_SECRET=replace-with-32-plus-random-bytes
NEXT_PUBLIC_SITE_URL=https://www.ieltswriting.online
NEXT_PUBLIC_SUPPORT_EMAIL=support@ieltswriting.online

# Public Supabase project URL and browser key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random salt used to pseudonymize administrator IPs in audit logs.
AUDIT_SALT=replace-with-32-plus-random-bytes

# Model provider used by the server-side grading and question endpoints.
# Provider, endpoint and model names can be overridden from /admin/models;
# API keys can be set from /admin/models and are stored encrypted, server-side.
# AI_API_KEY is the fallback when no admin key is stored, or admin settings are disabled.
AI_PROVIDER=qwen
AI_API_KEY=
# Optional stable server-only encryption secret. If omitted, encryption uses
# SUPABASE_SERVICE_ROLE_KEY. Rotating the selected secret requires re-entering
# the saved model API key. Never use a NEXT_PUBLIC_ variable for this secret.
AI_SETTINGS_ENCRYPTION_KEY=
AI_BASE_URL=
AI_MODEL=
QWEN_GRADING_MODEL=qwen3.5-plus
QWEN_STUDY_PLAN_MODEL=qwen3.5-plus
QWEN_VISION_MODEL=qwen3.5-plus
QWEN_VISION_FALLBACK_MODEL=qwen3.5-flash

# Optional version label shown in support diagnostics.
NEXT_PUBLIC_APP_VERSION=1.1.0

# Stripe subscriptions. Server-only; use separate sandbox and live credentials.
# Prefer a restricted key with only the required Billing/Checkout permissions.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Recurring CNY 1999 minor units / month (RMB 19.99).
STRIPE_PRICE_MONTHLY=
# Optional: a recurring annual CNY price; hidden until configured.
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
# One trial per account: 1 day without a card, or 3 days with explicit auto-renew consent.
# No-card trials require Subscriptions write access on the restricted runtime key.
STRIPE_TRIAL_ENABLED=true
# Enable only after Alipay and WeChat Pay are activated in this Stripe account.
# One-time RMB 19.99 for 30 days; existing subscriptions remain available.
STRIPE_PREPAID_ENABLED=false
# PayPal one-time GBP 2.49 for 30 days. Enable after the business account is linked.
STRIPE_PAYPAL_ENABLED=false
