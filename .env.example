# Next.js server/admin proxy
ADMIN_SESSION_SECRET=replace-with-32-plus-random-bytes
ADMIN_LICENSE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/admin-license
ADMIN_EDGE_SECRET=replace-with-admin-edge-secret

# Public Supabase project URL. Do not put service role keys in Next.js or Electron client config.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# License token verification. The private key lives only in Supabase Edge Function secrets.
LICENSE_TOKEN_PUBLIC_KEY_PEM=
LICENSE_TOKEN_TTL_SECONDS=21600

# Electron desktop activation/update endpoints
LICENSE_SERVER_URL=https://your-project.supabase.co/functions/v1/license
APP_UPDATE_URL=https://your-project.supabase.co/functions/v1/app-update
UPDATE_FEED_URL=https://updates.example.com/ielts-writing/stable
UPDATE_CHANNEL=stable
AUTO_UPDATE_DOWNLOAD_ENABLED=false
NEXT_PUBLIC_DEVELOPER_CONTACT=

# Supabase Edge Function secrets only:
# SUPABASE_SERVICE_ROLE_KEY=
# LICENSE_TOKEN_PRIVATE_KEY_PEM=
# LICENSE_KEY_PEPPER=
# ADMIN_PASSWORD=change-this-before-production
# ADMIN_PASSWORD_SHA256=
# ADMIN_EDGE_SECRET=
# RELEASE_BUCKET=ielts-app-updates

# AI provider for the protected grading endpoint.
AI_PROVIDER=qwen
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# .env.release.local for npm run release:mac. Keep this file local and ignored.
# RELEASE_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ielts-app-updates
# R2_PUBLIC_BASE_URL=https://updates.example.com
# ADMIN_LICENSE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/admin-license
# ADMIN_EDGE_SECRET=
# RELEASE_CHANNEL=stable
# RELEASE_ARCHITECTURE=arm64
# MINIMUM_SUPPORTED_VERSION=1.0.0
# RELEASE_NOTES=

# GitHub Actions/electron-builder signing inputs are loaded from repository secrets:
# WINDOWS_CERTIFICATE_BASE64
# WINDOWS_CERTIFICATE_PASSWORD
# CSC_LINK
# CSC_KEY_PASSWORD
# APPLE_ID
# APPLE_APP_SPECIFIC_PASSWORD
# APPLE_TEAM_ID
NEXT_PUBLIC_APP_VERSION=1.0.5
